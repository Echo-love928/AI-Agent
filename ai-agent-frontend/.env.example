# Development requests go through Vite to avoid browser CORS issues.
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://localhost:8123
# The repository controller uses mind_app. For the supplied API contract,
# change this value to /ai/mindapp/chat/sse.
VITE_MIND_CHAT_PATH=/ai/mind_app/chat/sse
VITE_MANUS_CHAT_PATH=/ai/manus/chat
